# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-staging
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.local

# Supabase CLI local link cache
supabase/.temp/

.vercel
.env*
# ...except the production build config. It holds no secrets - a browser API key
# and public service URLs - and a build's destination should be visible in the
# review that ships it, not typed into a dashboard nobody reads.
!.env.production
# ...and the staging preview config, for the same reason - and so a reviewer
# can see it points only at prooflab-staging-* services, never production.
!.env.staging

# TypeScript incremental build cache — machine-local, not source
*.tsbuildinfo

# Screenshots and measurements from scripts/screens.mjs. Regenerated on demand,
# and 5 MB of PNGs is not history worth keeping.
screenshots/
scripts/dev-tools/sections.json
scripts/dev-tools/matches.json
scripts/dev-tools/__pycache__/
__pycache__/
*.pyc

# Output of local check tools (never committed): browser E2E screenshots and
# inventories (E2E_OUT, default e2e-out/), authz_matrix_check.py results, and the
# failure screenshot voice_playback_browser.mjs writes.
e2e-out/
authz_matrix_results.json
voice-playback-fail.png
